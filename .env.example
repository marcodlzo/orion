# =============================================================================
# Environment template — placeholders only. NEVER commit real credentials.
#
# Copy to .env.local and fill in. .env, .env.local and .env*.local are
# gitignored; only this template is tracked.
#
# NAMING RULE
#   NEXT_PUBLIC_*  is inlined into the browser bundle and is PUBLIC.
#   Everything else is server-only and MUST NOT be renamed to NEXT_PUBLIC_*.
#   Appwrite admin keys, Plaid secrets and Dwolla secrets are server-only.
# =============================================================================


# -----------------------------------------------------------------------------
# APPWRITE — REQUIRED
# -----------------------------------------------------------------------------

# PUBLIC — safe in the browser bundle.
NEXT_PUBLIC_APPWRITE_ENDPOINT=https://cloud.appwrite.io/v1
NEXT_PUBLIC_APPWRITE_PROJECT=your-appwrite-project-id

# SERVER-ONLY — admin API key. Bypasses all Appwrite permission rules.
# Treat as a root credential; never expose to the client.
NEXT_APPWRITE_KEY=your-appwrite-api-key

# SERVER-ONLY — database and collection identifiers.
APPWRITE_DATABASE_ID=your-database-id
APPWRITE_USER_COLLECTION_ID=your-user-collection-id
APPWRITE_BANK_COLLECTION_ID=your-bank-collection-id
APPWRITE_TRANSACTION_COLLECTION_ID=your-transaction-collection-id


# -----------------------------------------------------------------------------
# PLAID — REQUIRED  (SERVER-ONLY)
# -----------------------------------------------------------------------------
# The Plaid environment is currently pinned to sandbox in lib/plaid.ts.
# PLAID_ENV is intentionally absent until the Plaid milestone makes it
# functional — see "Removed variables" below.
PLAID_CLIENT_ID=your-plaid-client-id
PLAID_SECRET=your-plaid-sandbox-secret


# -----------------------------------------------------------------------------
# DWOLLA — REQUIRED  (SERVER-ONLY)
# -----------------------------------------------------------------------------
# DWOLLA_ENV must be exactly "sandbox" or "production"; any other value throws
# at module load (lib/actions/dwolla.actions.ts).
DWOLLA_KEY=your-dwolla-key
DWOLLA_SECRET=your-dwolla-secret
DWOLLA_ENV=sandbox


# -----------------------------------------------------------------------------
# SENTRY — OPTIONAL
# -----------------------------------------------------------------------------
# Entirely optional. With no DSN the SDK never initialises and nothing is
# transmitted. A missing Sentry configuration must never fail a build.
#
# Point these at infrastructure YOU own. The tutorial's hardcoded DSN and
# "jsm-x9" org have been removed.

# OPTIONAL — PUBLIC. Browser error reporting.
# NEXT_PUBLIC_SENTRY_DSN=

# OPTIONAL — SERVER-ONLY. Falls back to NEXT_PUBLIC_SENTRY_DSN when unset.
# SENTRY_DSN=

# OPTIONAL — source-map upload at build time. Without SENTRY_AUTH_TOKEN the
# Sentry webpack plugin runs in dry-run mode and the build still succeeds.
# SENTRY_ORG=
# SENTRY_PROJECT=
# SENTRY_AUTH_TOKEN=

# OPTIONAL — telemetry volume. All default to 0 (nothing sampled).
# Session replay masks all text, inputs and media when enabled.
# NEXT_PUBLIC_SENTRY_ENVIRONMENT=
# SENTRY_ENVIRONMENT=
# NEXT_PUBLIC_SENTRY_TRACES_SAMPLE_RATE=0
# SENTRY_TRACES_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_REPLAYS_SESSION_SAMPLE_RATE=0
# NEXT_PUBLIC_SENTRY_REPLAYS_ON_ERROR_SAMPLE_RATE=0


# =============================================================================
# Removed variables — present in the tutorial template, unused by any code.
# Verified dead by grep over app/, components/, lib/, types/, constants/.
#
#   APPWRITE_ITEM_COLLECTION_ID  no item collection exists
#   PLAID_ENV                    lib/plaid.ts hardcodes PlaidEnvironments.sandbox
#   PLAID_PRODUCTS               products are hardcoded to ['auth']
#   PLAID_COUNTRY_CODES          country codes are hardcoded to ['US']
#   DWOLLA_BASE_URL              dwolla-v2 derives the base URL from DWOLLA_ENV
#   NEXT_PUBLIC_SITE_URL         never referenced
#
# Reintroduce a variable only in the same change that makes it functional.
# =============================================================================
